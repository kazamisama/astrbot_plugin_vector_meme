{
  "version": 2,
  "description": "vector_meme tag schema v2：17 标签、三分类（emotion/social_action/context_meme）。meaning 含群氛围匹配提示（emotion 类），用于 LLM 标签注入、人工标注与检索提示。",
  "tags": {
    "happy": {
      "category": "emotion",
      "meaning": "开心、高兴、愉快、轻松正反馈。群氛围活跃/愉悦时优先使用。",
      "visual_features": [
        "笑脸",
        "明亮表情",
        "活泼动作"
      ],
      "exclude": [
        "恋爱心动",
        "惊讶",
        "得意嘲讽",
        "爆笑"
      ],
      "color": "#FFD54F"
    },
    "laugh": {
      "category": "emotion",
      "meaning": "画面是“笑”的善意搞笑图（大笑/笑哭/咧嘴），负责搞笑接梗归类，不绑定情绪场景；有梗、需要搞笑反应图时用。",
      "visual_features": [
        "大笑",
        "笑哭",
        "咧嘴"
      ],
      "exclude": [
        "冷笑/坏笑/嘲讽",
        "心动",
        "高兴愉悦"
      ],
      "color": "#FFB74D"
    },
    "heart": {
      "category": "emotion",
      "meaning": "广义爱心：喜欢、心动、爱了，对内容/人/氛围的情感偏好（“我好喜欢这个”）；恋爱话题、被击中时用。",
      "visual_features": [
        "爱心眼",
        "红心",
        "捧脸"
      ],
      "exclude": [
        "表态赞同",
        "害羞",
        "感谢"
      ],
      "color": "#F48FB1"
    },
    "shy": {
      "category": "emotion",
      "meaning": "反应型害羞：被夸、被撩、被点名时的脸红不好意思；夸夸/恋爱氛围下优先。",
      "visual_features": [
        "脸红",
        "捂脸",
        "低头",
        "躲闪"
      ],
      "exclude": [
        "心动",
        "盯人"
      ],
      "color": "#F8BBD0"
    },
    "angry": {
      "category": "emotion",
      "meaning": "生气+敌意：火气、不满，含冷笑/坏笑/嘲讽/翻白眼等攻击性表达；被冒犯、被挑衅、意见不合时用。",
      "visual_features": [
        "火气",
        "炸毛",
        "皱眉",
        "怒目",
        "冷笑"
      ],
      "exclude": [
        "伤心低落",
        "委屈哭",
        "笨蛋呆"
      ],
      "color": "#E57373"
    },
    "sad": {
      "category": "emotion",
      "meaning": "压抑型低落：伤心、沮丧、委屈但没哭出来，垂头丧气；群氛围低落、被打击时用。",
      "visual_features": [
        "垂头",
        "低气压",
        "无神",
        "抱膝",
        "叹气"
      ],
      "exclude": [
        "落泪崩溃",
        "生气"
      ],
      "color": "#90CAF9"
    },
    "cry": {
      "category": "emotion",
      "meaning": "破防通用：哭出来、崩溃、泪目，难过哭与感动泪目都收；被虐到、破防、被感动时用。",
      "visual_features": [
        "落泪",
        "大哭",
        "崩溃",
        "哭唧唧"
      ],
      "exclude": [
        "忍住不哭",
        "生气"
      ],
      "color": "#64B5F6"
    },
    "surprised": {
      "category": "emotion",
      "meaning": "刺激型震惊：被意外冲击的即时反应（瞳孔地震）；突发、反转、意外消息时用。",
      "visual_features": [
        "瞪眼",
        "张嘴",
        "呆住"
      ],
      "exclude": [
        "困惑"
      ],
      "color": "#FFAB91"
    },
    "confused": {
      "category": "emotion",
      "meaning": "纯困惑+神奇发言：想不通、搞不懂、一脸问号，对方说了莫名其妙的话也走这条。",
      "visual_features": [
        "歪头",
        "问号",
        "挠头",
        "呆滞"
      ],
      "exclude": [
        "惊讶",
        "无语嫌弃"
      ],
      "color": "#A1887F"
    },
    "baka": {
      "category": "emotion",
      "meaning": "呆萌犯傻：笨蛋、傻乎乎，说别人傻或自嘲犯蠢都可用；犯蠢时刻、蠢萌反应。",
      "visual_features": [
        "呆滞",
        "犯傻",
        "蠢萌"
      ],
      "exclude": [
        "困惑",
        "生气嘲讽"
      ],
      "color": "#CE93D8"
    },
    "like": {
      "category": "social_action",
      "meaning": "纯赞同表态：+1、说得对、支持你；理性表态，不含情感性喜欢；好耶/不错这类轻量正反馈归 happy。",
      "visual_features": [
        "竖大拇指",
        "点赞",
        "点头"
      ],
      "exclude": [
        "情感喜欢",
        "感谢"
      ],
      "color": "#81C784"
    },
    "thanks": {
      "category": "social_action",
      "meaning": "礼数感谢全收：鞠躬、合十、递茶、比心等表达谢意的画面；求人办事、被帮助后的回应。",
      "visual_features": [
        "鞠躬",
        "双手合十",
        "递茶",
        "比心"
      ],
      "exclude": [
        "赞同",
        "心动"
      ],
      "color": "#AED581"
    },
    "see": {
      "category": "social_action",
      "meaning": "暗中观察/吃瓜：“我看看你在干嘛”的围观心态，吃瓜、监视、盯梢。",
      "visual_features": [
        "眼睛特写",
        "盯视",
        "暗中观察"
      ],
      "exclude": [
        "害羞",
        "困惑",
        "惊讶"
      ],
      "color": "#4DB6AC"
    },
    "meow": {
      "category": "social_action",
      "meaning": "猫系+萌系通用：画面有猫或明显卖萌撒娇姿态都收；“喵”“蹭蹭”求关注求抚摸。",
      "visual_features": [
        "猫",
        "猫耳",
        "蹭蹭",
        "打滚",
        "眨眼"
      ],
      "exclude": [
        "害羞",
        "心动"
      ],
      "color": "#FFCC80"
    },
    "morning": {
      "category": "context_meme",
      "meaning": "早安问候为主：早安、新的一天开始，早上打招呼的场景；没睡醒/起床气归 sleep。",
      "visual_features": [
        "太阳",
        "闹钟",
        "伸懒腰",
        "早安文案"
      ],
      "exclude": [
        "困倦"
      ],
      "color": "#FFF59D"
    },
    "sleep": {
      "category": "context_meme",
      "meaning": "晚安+困倦全收：道晚安、想睡、打哈欠、没睡醒、起床气；晚上道晚安或白天犯困时用。",
      "visual_features": [
        "月亮",
        "睡觉",
        "打哈欠",
        "晚安文案"
      ],
      "exclude": [
        "早安"
      ],
      "color": "#7986CB"
    },
    "kfc": {
      "category": "context_meme",
      "meaning": "纯 KFC 玩梗：疯狂星期四、V我50，星期四群氛围玩梗时优先；纯梗类无情绪维度。",
      "visual_features": [
        "KFC logo",
        "炸鸡",
        "疯狂星期四文案"
      ],
      "exclude": [
        "其他乞讨/要钱梗",
        "食物图"
      ],
      "color": "#FF8A65"
    }
  }
}
